{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkDraft",
  "mainBinaryName": "markdraft",
  "version": "0.1.0",
  "identifier": "app.markdraft.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "pnpm --filter markdraft-ui dev",
    "beforeBuildCommand": "pnpm --filter markdraft-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkDraft",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Read, write and export Markdown",
    "longDescription": "MarkDraft is a fast, local-first Markdown reader and writer with a file tree, workspaces and PDF export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
